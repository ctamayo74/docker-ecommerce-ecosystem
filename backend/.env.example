APP_NAME="Ecommerce API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/El_Salvador
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# BASE DE DATOS (MySQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ecommerce_api
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# SANCTUM (autenticación por tokens)
# ---------------------------------------------------------------------------
# Dominios adicionales que pueden usar autenticación stateful (SPA). No es
# necesario para consumo puro vía Bearer Token desde apps móviles/externas.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# ---------------------------------------------------------------------------
# STRIPE (pasarela de pago)
# Obtén tus llaves de prueba en https://dashboard.stripe.com/test/apikeys
# ---------------------------------------------------------------------------
STRIPE_KEY=
STRIPE_SECRET=
# Secreto del webhook (Stripe CLI o dashboard > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=
# Moneda por defecto para los cargos (ISO 4217, en minúsculas)
STRIPE_CURRENCY=usd

# ---------------------------------------------------------------------------
# L5-SWAGGER (documentación OpenAPI)
# ---------------------------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=http://localhost:8000/api
L5_FORMAT_TO_USE_FOR_DOCS=json
