# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=change_me_user

# ===== Laravel =====
# Genera uno con: docker run --rm php:8.2-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
APP_KEY=
APP_URL=http://localhost:8000
# true = ejecuta php artisan migrate --force al arrancar (úsalo en primer despliegue)
RUN_MIGRATIONS=true
# Clave secreta de Stripe (sk_test_...). Ajusta el nombre al que use tu API.
STRIPE_SECRET=sk_test_xxx

# ===== Next.js =====
# Clave PUBLICABLE (pk_test_...). Se incrusta en el bundle durante el BUILD.
NEXT_PUBLIC_STRIPE_KEY=pk_test_xxx
# URL de la API vista desde el contenedor del frontend (red interna de Docker).
# Ajusta el NOMBRE de la variable al que lea tu lib/api.ts.
API_URL=http://backend/api

# ===== Puertos publicados en el host =====
FRONTEND_PORT=3000
BACKEND_PORT=8000
